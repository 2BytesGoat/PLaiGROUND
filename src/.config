# You can get your ENV_PATH from the `~` developer console inside the game
ENV_PATH="./environments"
ENV_NAME="DragonJump"

# Run the game straight from its Godot project instead of an exported binary.
# Empty = use the exported binary from ENV_PATH/ENV_NAME.
GODOT_PATH="/Applications/Godot.app"
GODOT_PROJECT_PATH="../dragon-jump-remaster"

# Training information
LEVEL="1-3"
NB_AGENTS=1

# This tells the game how many frames to keep the same action
ACTION_REPEAT=1

# This sets the run speed for the game
SPEEDUP=1
SHOW_WINDOW=TRUE